{
  "name": "space-relics",
  "version": "1.0.0",
  "private": true,
  "description": "Space Relics — Abandoned but Not Forgotten. Next.js shell + relic API + Launch Lab / Planet Explorer 3D apps.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "next dev -p 3000",
